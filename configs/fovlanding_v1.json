{
  "protocol": {
    "name": "fovlanding-v1",
    "quantization": "floor100-v1",
    "event_rule": "merge-fixa-purs-v1",
    "task": "free_viewing",
    "cutoff_rule": "next_saccade_onset",
    "gaze_input_rule": "sample_time_strictly_less_than_cutoff",
